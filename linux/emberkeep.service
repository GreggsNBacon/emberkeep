[Unit]
Description=Emberkeep game server manager
Documentation=https://github.com/GreggsNBacon/emberkeep
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=emberkeep
Group=emberkeep
WorkingDirectory=/var/lib/emberkeep
ExecStart=/opt/emberkeep/emberkeep
# Comes back after a crash, and after an update (Emberkeep exits so the new version starts).
Restart=always
RestartSec=5
# Stopping: only Emberkeep gets SIGTERM; it stops each game server the proper way (so worlds save) before exiting.
# Game servers can take a while to save, hence the long timeout before anything is force-closed.
KillMode=mixed
TimeoutStopSec=300
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/emberkeep/.cache/dotnet
LimitNOFILE=65536
# New files: the emberkeep user and its group (the people allowed to manage Emberkeep), nobody else.
UMask=0027

[Install]
WantedBy=multi-user.target
