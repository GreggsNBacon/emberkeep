<Project Sdk="WixToolset.Sdk/6.0.2">
  <!-- Builds Hostbay-Setup.msi from the single-file exe in ..\publish (run ..\build.ps1). -->
  <PropertyGroup>
    <OutputName>Hostbay-Setup</OutputName>
    <Platform>x64</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <!-- A new ProductCode per build makes every installer an upgrade of the last (see Package.wxs). -->
    <ProductCode Condition="'$(ProductCode)' == ''">$([System.Guid]::NewGuid().ToString("B").ToUpperInvariant())</ProductCode>
    <DefineConstants>PublishDir=$(PublishDir);ProductCode=$(ProductCode)</DefineConstants>
    <!-- ICE91: per-user files by design; this package never installs per-machine.
         ICE61: same-version upgrades are deliberate so rebuilt installers replace each other. -->
    <SuppressIces>ICE91;ICE61</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
